# Frontend Environment Variables
# Copy this to .env.local in the frontend/ directory

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Polar Product IDs (from your Polar dashboard)
NEXT_PUBLIC_PRO_MONTHLY_ID=5a5d3759-7d82-4b42-a8c3-8dc1b38607d7
NEXT_PUBLIC_PRO_YEARLY_ID=b287ed1a-1160-4c93-bd78-e1d0ac433183
NEXT_PUBLIC_BUSINESS_ID=4aa72a7a-e858-4de8-b6b5-2d6a94ed8ded

# Admin emails (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
