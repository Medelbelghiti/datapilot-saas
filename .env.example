# ============================================================
# DataPilot AI — Environment Variables
# ============================================================
# Copy this file to .env.local (frontend) and .env (backend)
# NEVER commit real secrets to version control.

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Polar.sh ──────────────────────────────────────────────────
# Get access token from: https://polar.sh/settings/tokens
POLAR_ACCESS_TOKEN=your-polar-access-token
# Get org ID from: https://polar.sh/settings/organizations
POLAR_ORGANIZATION_ID=your-polar-org-id
# Product IDs from your Polar dashboard > Products
POLAR_PRO_MONTHLY_PRODUCT_ID=5a5d3759-7d82-4b42-a8c3-8dc1b38607d7
POLAR_PRO_YEARLY_PRODUCT_ID=b287ed1a-1160-4c93-bd78-e1d0ac433183
POLAR_BUSINESS_PRODUCT_ID=4aa72a7a-e858-4de8-b6b5-2d6a94ed8ded
# Webhook secret from: https://polar.sh/settings/webhooks
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# "sandbox" for testing, "production" for live
POLAR_ENV=sandbox

# ── n8n ───────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/
N8N_API_KEY=your-n8n-api-key

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/datapilot

# ── Backend ───────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────
# Comma-separated list of admin emails
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com

# ── Misc ──────────────────────────────────────────────────────
NODE_ENV=development
